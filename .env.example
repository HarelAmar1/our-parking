# Set on Vercel > Project > Settings > Environment Variables (server-only)
# FIREBASE_SERVICE_ACCOUNT_JSON is ONE-LINE raw JSON downloaded from Firebase service accounts.
FIREBASE_SERVICE_ACCOUNT_JSON=
INVITE_CODE=
MANAGER_CODE=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com
# This public key is embedded at build time in browser JS, unlike the private key.
VITE_VAPID_PUBLIC_KEY=
